rules_version = '2';

// Multi-tenant: each signed-in user owns their OWN photos under cards/{uid}/…,
// keyed by their auth uid. Access is granted only when the path's uid segment
// equals the caller's uid, so no one can read/write another person's images.
// Everyone must have a verified email.
//
// This replaced the single shared "family" space + email allowlist. Cross-user
// sharing is deferred to a later phase.
//
// `get` and NOT `read`: granting `list` would let a client walk the tree.
// Images are fetched by exact path (the Firestore index records which exist).
//
// Thumbnails (*_thumb.jpg) are written by the Cloud Function through the Admin
// SDK, which bypasses these rules — no extra write grant is needed.
service firebase.storage {
  match /b/{bucket}/o {

    function cardsVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    match /cards/{uid}/{allPaths=**} {
      allow get: if cardsVerified() && request.auth.uid == uid;

      // Writes must be images of a sane size, so a compromised session cannot be
      // used to park arbitrary files in the bucket.
      allow write: if cardsVerified() && request.auth.uid == uid
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      allow delete: if cardsVerified() && request.auth.uid == uid;
    }

    // Everything else is denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
