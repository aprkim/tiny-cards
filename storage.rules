rules_version = '2';

// Cards are addressed by sync code, mirroring the Firestore pattern in tiny-do.
// The sync code is the shared secret: knowing it grants access to that space.
//
// `get` and NOT `read`. In Storage rules `read` means `get` + `list`, and
// granting `list` was enough to enumerate every sync code: a request for
// prefix "cards/" with delimiter "/" came back with the full set of codes as
// prefixes, even though the rule is nested a level below. Nesting the match
// does not protect the parent prefix — only withholding `list` does.
//
// Consequence: no client can list anything here, so the archive cannot learn
// what a space holds by walking Storage. Card metadata lives in Firestore
// instead, and images are fetched by exact path.
service firebase.storage {
  match /b/{bucket}/o {

    match /cards/{syncCode}/{allPaths=**} {
      allow get: if request.auth != null;

      // Writes must be images of a sane size, so a leaked code cannot be
      // used to park arbitrary files in the bucket.
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null;
    }

    // Everything else is denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
