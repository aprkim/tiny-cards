rules_version = '2';

// One shared family space with an email allowlist: the owner can read and
// write, named viewers can only read, and everyone must have a verified
// email. This replaced uid-keyed paths, which made viewer access impossible
// — a viewer's uid never matches the owner's path segment.
//
// `get` and NOT `read`. In Storage rules `read` means `get` + `list`, and
// granting `list` lets a client walk the tree (an earlier revision leaked
// every sync code that way). Nothing here can be listed: the Firestore index
// records which paths exist, and images are fetched by exact path.
//
// Thumbnails (*_thumb.jpg) are written by the Cloud Function through the
// Admin SDK, which bypasses these rules — no extra write grant is needed.
//
// The viewer list must be kept in step with the one in
// tiny-do/firestore.rules (Firestore rules are project-wide and deploy from
// that repo).
service firebase.storage {
  match /b/{bucket}/o {

    function cardsVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function cardsOwner() {
      return cardsVerified() && request.auth.token.email == 'aprkim@gmail.com';
    }
    function cardsViewer() {
      // Granted by redeeming an invite (a Cloud Function sets this claim) and
      // revocable by the owner. Replaced the hardcoded email allowlist; keep in
      // step with cardsViewer() in tiny-do/firestore.rules.
      return cardsVerified() && request.auth.token.cardsViewer == true;
    }

    match /cards/{space}/{allPaths=**} {
      allow get: if cardsOwner() || cardsViewer();

      // Writes must be images of a sane size, so a compromised session
      // cannot be used to park arbitrary files in the bucket.
      allow write: if cardsOwner()
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      allow delete: if cardsOwner();
    }

    // Everything else is denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
