rules_version = '2';

// Cards are addressed by sync code, mirroring the Firestore pattern in tiny-do.
// The sync code is the shared secret: knowing it grants access to that space.
//
// Note the shape of the match. Because the only rule is nested one level under
// /cards/{syncCode}, a client cannot list /cards itself — so sync codes cannot
// be enumerated. Listing is only possible inside a prefix you already know.
service firebase.storage {
  match /b/{bucket}/o {

    match /cards/{syncCode}/{allPaths=**} {
      // Anonymous auth is enough; the sync code is what scopes access.
      allow read: if request.auth != null;

      // Writes additionally must be images and of a sane size, so a leaked
      // code cannot be used to park arbitrary files in the bucket.
      allow write: if request.auth != null
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null;
    }

    // Everything else is denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
